{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficeDocument",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "docx"
        }
      },
      "$ref": "#/$defs/VersionedDocxDocument",
      "required": [
        "format"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "xlsx"
        }
      },
      "$ref": "#/$defs/VersionedXlsxDocument",
      "required": [
        "format"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "pptx"
        }
      },
      "$ref": "#/$defs/VersionedPptxDocument",
      "required": [
        "format"
      ]
    }
  ],
  "$defs": {
    "DocxPart": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Package path, e.g. `word/document.xml`, `word/header1.xml`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PartKind"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxBlock"
          }
        },
        "sectionProps": {
          "description": "Final section properties of the body (page size, margins, header references).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "kind",
        "blocks"
      ]
    },
    "PartKind": {
      "type": "string",
      "enum": [
        "body",
        "header",
        "footer"
      ]
    },
    "DocxBlock": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            }
          },
          "$ref": "#/$defs/DocxParagraph",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            }
          },
          "$ref": "#/$defs/DocxTable",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "raw"
            }
          },
          "$ref": "#/$defs/DocxRaw",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ListRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "format": "double"
        },
        "level": {
          "type": "number",
          "format": "double",
          "default": 0
        }
      },
      "required": [
        "id"
      ]
    },
    "DocxInline": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run"
            }
          },
          "$ref": "#/$defs/DocxRun",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "break"
            }
          },
          "$ref": "#/$defs/DocxBreak",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hyperlink"
            }
          },
          "$ref": "#/$defs/DocxHyperlink",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "raw"
            }
          },
          "$ref": "#/$defs/DocxRaw",
          "required": [
            "type"
          ]
        }
      ]
    },
    "DocxUnderline": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "DocxRun": {
      "type": "object",
      "properties": {
        "text": {
          "description": "Text; `\\n` is a line break and `\\t` a tab.",
          "type": "string",
          "default": ""
        },
        "style": {
          "description": "Character style id.",
          "type": [
            "string",
            "null"
          ]
        },
        "bold": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "italic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "underline": {
          "description": "`true` = single underline, or an underline type (`double`, `wave`, ...).",
          "anyOf": [
            {
              "$ref": "#/$defs/DocxUnderline"
            },
            {
              "type": "null"
            }
          ]
        },
        "strike": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "color": {
          "description": "Hex color without `#`, e.g. `FF0000`.",
          "type": [
            "string",
            "null"
          ]
        },
        "highlight": {
          "description": "Highlight color name, e.g. `yellow`.",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "Font size in points.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "font": {
          "type": [
            "string",
            "null"
          ]
        },
        "vertAlign": {
          "description": "`superscript` | `subscript` | `baseline`.",
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "description": "Original `<w:rPr>` XML. Fields override it when changed.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BreakKind": {
      "type": "string",
      "enum": [
        "page",
        "column"
      ]
    },
    "DocxBreak": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/BreakKind"
        }
      },
      "required": [
        "kind"
      ]
    },
    "DocxHyperlink": {
      "type": "object",
      "properties": {
        "url": {
          "description": "External URL.",
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "description": "Internal bookmark name.",
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxInline"
          },
          "default": []
        }
      }
    },
    "DocxRaw": {
      "description": "Anything not modelled (images, fields, bookmarks, content controls...), kept as XML.",
      "type": "object",
      "properties": {
        "xml": {
          "type": "string"
        }
      },
      "required": [
        "xml"
      ]
    },
    "DocxParagraph": {
      "type": "object",
      "properties": {
        "style": {
          "description": "Paragraph style id, e.g. `Heading1`, `ListParagraph`.",
          "type": [
            "string",
            "null"
          ]
        },
        "align": {
          "description": "`left` | `center` | `right` | `justify`.",
          "type": [
            "string",
            "null"
          ]
        },
        "list": {
          "description": "Numbering (bullets / numbered lists).",
          "anyOf": [
            {
              "$ref": "#/$defs/ListRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxInline"
          },
          "default": []
        },
        "props": {
          "description": "Original `<w:pPr>` XML. Fields above override it when changed.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DocxTableRow": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxTableCell"
          }
        },
        "props": {
          "description": "Original `<w:trPr>` XML.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cells"
      ]
    },
    "DocxTableCell": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxBlock"
          },
          "default": []
        },
        "colSpan": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "vMerge": {
          "description": "`restart` | `continue`.",
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "description": "Original `<w:tcPr>` XML.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DocxTable": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxTableRow"
          }
        },
        "props": {
          "description": "Original `<w:tblPr>` XML.",
          "type": [
            "string",
            "null"
          ]
        },
        "grid": {
          "description": "Original `<w:tblGrid>` XML.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rows"
      ]
    },
    "VersionedDocxDocument": {
      "type": "object",
      "properties": {
        "modelVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxPart"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "XlsxSheet": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Package path of an existing sheet. Omit to create a new sheet on build.",
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XlsxRow"
          },
          "default": []
        },
        "merges": {
          "description": "Merged ranges, e.g. `A1:C1`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "XlsxRow": {
      "type": "object",
      "properties": {
        "index": {
          "description": "1-based row number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "Custom height in points.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hidden": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XlsxCell"
          },
          "default": []
        }
      },
      "required": [
        "index"
      ]
    },
    "XlsxCell": {
      "type": "object",
      "properties": {
        "ref": {
          "description": "A1-style reference. When omitted, the cell goes to the column after the previous one.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "string | number | boolean | null.",
          "default": null
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellType"
            },
            {
              "type": "null"
            }
          ]
        },
        "formula": {
          "description": "Formula without the leading `=`. `value` holds the cached result.",
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "description": "Index into the workbook cell formats (`cellXfs`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "richText": {
          "description": "Original rich-text XML (`<r>` runs). Used when `value` still equals its plain text.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CellType": {
      "oneOf": [
        {
          "description": "A date-formatted number; `value` is an ISO string.",
          "type": "string",
          "const": "date"
        },
        {
          "description": "`#N/A` & co.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "VersionedXlsxDocument": {
      "type": "object",
      "properties": {
        "modelVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "sheets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XlsxSheet"
          }
        }
      },
      "required": [
        "sheets"
      ]
    },
    "PptxSlide": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Package path of the slide, e.g. `ppt/slides/slide1.xml`.",
          "type": "string"
        },
        "shapes": {
          "description": "Shapes in z-order. Shapes missing from the list are removed on build.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxShape"
          },
          "default": []
        },
        "notes": {
          "description": "Speaker notes as plain text.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ]
    },
    "PptxShape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "$ref": "#/$defs/PptxTextShape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            }
          },
          "$ref": "#/$defs/PptxTableShape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "picture"
            }
          },
          "$ref": "#/$defs/PptxOtherShape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "group"
            }
          },
          "$ref": "#/$defs/PptxOtherShape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "connector"
            }
          },
          "$ref": "#/$defs/PptxOtherShape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "graphic"
            }
          },
          "$ref": "#/$defs/PptxOtherShape",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "other"
            }
          },
          "$ref": "#/$defs/PptxOtherShape",
          "required": [
            "type"
          ]
        }
      ]
    },
    "PptxParagraph": {
      "type": "object",
      "properties": {
        "align": {
          "description": "`left` | `center` | `right` | `justify`.",
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "description": "Outline (bullet) level, 0-based.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxInline"
          },
          "default": []
        },
        "props": {
          "description": "Original `<a:pPr>` XML.",
          "type": [
            "string",
            "null"
          ]
        },
        "endProps": {
          "description": "Original `<a:endParaRPr>` XML.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PptxInline": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run"
            }
          },
          "$ref": "#/$defs/PptxRun",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "raw"
            }
          },
          "$ref": "#/$defs/PptxRaw",
          "required": [
            "type"
          ]
        }
      ]
    },
    "PptxUnderline": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "PptxRun": {
      "type": "object",
      "properties": {
        "text": {
          "description": "Text; `\\n` is a line break.",
          "type": "string",
          "default": ""
        },
        "bold": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "italic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "underline": {
          "anyOf": [
            {
              "$ref": "#/$defs/PptxUnderline"
            },
            {
              "type": "null"
            }
          ]
        },
        "strike": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "size": {
          "description": "Font size in points.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "color": {
          "description": "Hex RGB color without `#`.",
          "type": [
            "string",
            "null"
          ]
        },
        "font": {
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "description": "Original `<a:rPr>` XML.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PptxRaw": {
      "description": "Fields (slide number, date) and other inline content, kept as XML.",
      "type": "object",
      "properties": {
        "xml": {
          "type": "string"
        }
      },
      "required": [
        "xml"
      ]
    },
    "PptxTextShape": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Shape id (`p:cNvPr/@id`), used to match shapes on build.",
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "placeholder": {
          "description": "Placeholder type when the shape is a layout placeholder: `title`, `body`, `subTitle`, ...",
          "type": [
            "string",
            "null"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxParagraph"
          },
          "default": []
        }
      },
      "required": [
        "id"
      ]
    },
    "PptxTableRow": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxTableCell"
          },
          "default": []
        }
      }
    },
    "PptxTableCell": {
      "type": "object",
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxParagraph"
          },
          "default": []
        }
      }
    },
    "PptxTableShape": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxTableRow"
          },
          "default": []
        }
      },
      "required": [
        "id"
      ]
    },
    "PptxOtherShape": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "xml": {
          "description": "Raw XML. Only needed to insert a new shape; existing shapes are taken from the base file.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "VersionedPptxDocument": {
      "type": "object",
      "properties": {
        "modelVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1
        },
        "slides": {
          "description": "Slides in presentation order. Reorder or remove items to reorder/remove slides.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxSlide"
          }
        }
      },
      "required": [
        "slides"
      ]
    }
  }
}
